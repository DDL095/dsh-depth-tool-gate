        <mxCell id="title" value="dtg v0.15.0 — 工具面治理全链路(来源感知 + 每 preset 一份配置)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
