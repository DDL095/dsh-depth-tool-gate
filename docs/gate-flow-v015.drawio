        <mxCell id="L_global" value="全局层&#xa;profile 顶层 insert 行&#xa;(62 件实测)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
