          <mxGeometry x="1040" y="230" width="130" height="80" as="geometry" />
        </mxCell>

        <mxCell id="reclass" value="存量 pending 重判: pending 且 不属全局层 → 改判 preset&#xa;★ 改入参不会让已存在的 pending 自动消失 ⇒ 重判是修复闭环的必要环节" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
