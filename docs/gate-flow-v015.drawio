        <mxCell id="L_preset" value="preset 层&#xa;preset config.plugins 行&#xa;(= agent 的父层)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="250" width="190" height="80" as="geometry" />
