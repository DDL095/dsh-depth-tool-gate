        <mxCell id="L_own" value="agent own 层&#xa;agent.ctx 补挂&#xa;(restrict 裁不掉)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="370" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="layer_note" value="关键事实(源码级)&#xa;&#xa;preset 层 = agent 父层&#xa;⇒ 其工具名进&#xa;view(agent).restrictableNames&#xa;⇒ 可裁&#xa;&#xa;(dtg 旧注释「够不着」是错的&#xa;v0.4.6 已推翻过一次)&#xa;&#xa;⇒ 域 preset 自己的工具&#xa;会被自己的闸门误杀&#xa;(故障 A 的根因)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="360" y="130" width="240" height="320" as="geometry" />
        </mxCell>

