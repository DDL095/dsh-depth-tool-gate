          <mxGeometry x="660" y="130" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="synclock" value="syncLock(known, globalNames)&#xa;新名按来源分类:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" vertex="1" parent="1">
